# Copy this file to .env.fit-rope-staging only for a manual staging deploy.
# CI creates the same runtime configuration from GitHub Environment variables.
APP_ENV=staging
# App OneSignal di STAGING. NON l'app di produzione
# (154fc17b-3ef8-4421-a1e6-466172fa48db): con quella le push di staging
# finirebbero sui device reali dei soci, e sia handler.ts sia staging.yml
# rifiutano il valore.
ONESIGNAL_APP_ID=REPLACE_WITH_STAGING_ONESIGNAL_APP_ID
STAGING_NOTIFICATION_EMAIL_ALLOWLIST=test.staging@example.com
# Base URL della PWA, usato come deeplink (`web_url`) delle push.
APP_BASE_URL=https://fgrotta.github.io/fitrope_app/
