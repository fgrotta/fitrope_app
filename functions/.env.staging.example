# Copy this file to .env.fit-rope-staging only for a manual staging deploy.
# CI creates the same runtime configuration from GitHub Environment variables.
APP_ENV=staging
ONESIGNAL_APP_ID=154fc17b-3ef8-4421-a1e6-466172fa48db
STAGING_NOTIFICATION_EMAIL_ALLOWLIST=test.staging@example.com

# WhatsApp lezioni demo: off (default) | test | live.
# Su staging lasciare off, oppure usare l'app Meta TEST: creare i secret
# META_WA_ACCESS_TOKEN, META_APP_SECRET e META_WA_VERIFY_TOKEN nel progetto
# fit-rope-staging e compilare l'allowlist: staging può contenere numeri reali
# clonati dalla produzione. In CI lo accende la var META_WA_PHONE_NUMBER_ID.
# WHATSAPP_DEMO_MODE=off
# WHATSAPP_TRANSPORT=meta
# META_GRAPH_VERSION=v26.0
# META_WA_PHONE_NUMBER_ID=<id del numero di test Meta>
# META_WA_TEMPLATE_REMINDER=promemoria_lezione_prova
# META_WA_TEMPLATE_LANG=it
# STAGING_WHATSAPP_ALLOWLIST=+393331234567
