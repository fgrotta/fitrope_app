# Copy this file to .env.fit-rope-staging only for a manual staging deploy.
# CI creates the same runtime configuration from GitHub Environment variables.
APP_ENV=staging
ONESIGNAL_APP_ID=154fc17b-3ef8-4421-a1e6-466172fa48db
STAGING_NOTIFICATION_EMAIL_ALLOWLIST=test.staging@example.com

# WhatsApp lezioni demo (webhook Make): off (default) | test.
# In CI li scrive staging.yml dalle vars STAGING_WHATSAPP_DEMO_MODE e
# STAGING_WHATSAPP_ALLOWLIST. Con test servono i secret MAKE_WEBHOOK_URL e
# MAKE_WEBHOOK_KEY nel progetto fit-rope-staging e l'allowlist compilata:
# staging può contenere numeri reali clonati dalla produzione.
# WHATSAPP_DEMO_MODE=off
# STAGING_WHATSAPP_ALLOWLIST=+393331234567
